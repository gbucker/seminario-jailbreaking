# Copie para .env e preencha:  cp .env.example .env
# O .env está no .gitignore: as chaves nunca vão para o GitHub.

# ─────────────────────────────────────────────────────────────
# Servidor local
# ─────────────────────────────────────────────────────────────
PORT=7681
# Shell do terminal. Em branco = detecta sozinho
# (Windows: C:\Program Files\Git\bin\bash.exe; Linux/macOS: $SHELL)
SHELL_PATH=

# ─────────────────────────────────────────────────────────────
# Teste 1 · SEM adulteração: serviço online, pesos fechados
# Qualquer API compatível com o formato OpenAI (/chat/completions):
#   OpenAI      https://api.openai.com/v1
#   OpenRouter  https://openrouter.ai/api/v1
#   Anthropic   https://api.anthropic.com/v1/      (camada de compatibilidade OpenAI)
#   Gemini      https://generativelanguage.googleapis.com/v1beta/openai
#   Groq        https://api.groq.com/openai/v1
#   DeepSeek    https://api.deepseek.com/v1
# ─────────────────────────────────────────────────────────────
ONLINE_LABEL="OpenAI"
ONLINE_BASE_URL=https://api.openai.com/v1
ONLINE_API_KEY=
ONLINE_MODEL=
# opcionais
ONLINE_SYSTEM_PROMPT=
ONLINE_TEMPERATURE=

# ─────────────────────────────────────────────────────────────
# Teste 2 · COM adulteração: modelo abliterado no Ollama
# OLLAMA_HOST: http://localhost:11434 se o Ollama roda nesta máquina;
# outra máquina na rede/Tailscale: http://<ip-ou-nome>:11434
# (lá, o Ollama precisa de OLLAMA_HOST=0.0.0.0 para aceitar conexões externas)
# OLLAMA_MODEL: o nome exatamente como aparece em `ollama list`
# ─────────────────────────────────────────────────────────────
OLLAMA_LABEL="Ollama · abliterado"
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=
# opcionais
OLLAMA_SYSTEM_PROMPT=
OLLAMA_TEMPERATURE=
# true / false / em branco (padrão do modelo): liga ou desliga o "pensamento" de modelos de raciocínio
OLLAMA_THINK=
OLLAMA_NUM_CTX=
# só se o Ollama estiver atrás de um proxy com autenticação
OLLAMA_API_KEY=
